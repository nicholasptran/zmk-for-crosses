#define DEFAULT 0
#define MOUSE   1
#define SCROLL  2
#define ARROW   3
#define ARROW2  4
#define KEYS_EXCLUDED_FROM_DISABLING_MOUSE_LAYER 22 31 33 34 43 44

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&trackball_listener {
    input-processors = <
        &zip_x_scaler 11 10
        &zip_y_scaler 9 10
        &zip_temp_layer MOUSE 500
    >;

    scroller: scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_xy_scaler 1 15
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <500>;
        excluded-positions = <KEYS_EXCLUDED_FROM_DISABLING_MOUSE_LAYER>;
    };

    macros {
        ctrl: macro_ctrl_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "MACRO_CTRL_KP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp MINUS      &kp N1   &kp N2  &kp N3        &kp N4       &kp N5    &kp N6  &kp N7     &kp N8         &kp N9   &kp N0    &kp EQUAL
&kp TAB        &kp Q    &kp W   &kp E         &kp R        &kp T     &kp Y   &kp U      &kp I          &kp O    &kp P     &kp BSLH
&kp BACKSPACE  &kp A    &kp S   &kp D         &kp F        &kp G     &kp H   &kp J      &kp K          &kp L    &kp SEMI  &kp APOS
&kp LCTRL      &lt 3 Z  &kp X   &kp C         &kp V        &kp B     &kp N   &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RCTRL
                                &kp LEFT_ALT  &lt 1 SPACE  &mo 2     &mo 3   &kp ENTER  &kp RIGHT_ALT
            >;

            label = "QWRT";
        };

        mouse_layer {
            bindings = <
&kp LS(N1)      &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)    &kp LS(N7)  &kp LS(N8)      &kp LS(N9)      &kp LS(N0)       &kp LS(MINUS)  &kp LS(EQUAL)
&kp TAB         &kp Q       &kp W       &kp E       &kp R       &kp T         &kp Y       &kp U           &kp I           &kp O            &kp P          &kp BSLH
&kp LEFT_SHIFT  &kp A       &kp S       &kp D       &kp F       &kp G         &kp H       &kp J           &kp UP_ARROW    &kp L            &kp SEMI       &kp APOS
&kp LCTRL       &kp Z       &kp X       &kp C       &kp V       &kp B         &kp N       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SLASH      &kp ESC
                                        &none       &none       &none         &none       &kp F12         &kp SPACE
            >;

            label = "MOUSE";
        };

        scroll_layer {
            bindings = <
&trans          &kp F1  &kp F2   &kp F3                &kp F4                 &kp F5    &kp F6     &kp F7  &kp F8  &kp F9  &kp F10    &kp F11
&trans          &kp Q   &ctrl W  &kp E                 &kp R                  &kp T     &kp PSCRN  &kp N7  &kp N8  &kp N9  &kp EQUAL  &kp F12
&kp LEFT_SHIFT  &kp A   &kp S    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans     &kp N4  &kp N5  &kp N6  &trans     &trans
&kp LCTRL       &kp Z   &kp X    &kp C                 &kp V                  &trans    &trans     &kp N1  &kp N2  &kp N3  &trans     &trans
                                 &trans                &trans                 &trans    &trans     &trans  &kp N0
            >;

            label = "SCROLL";
        };

        arrow_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans    &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PSCRN  &trans    &kp UP    &kp EQUAL  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans    &trans    &trans     &trans     &trans
                        &trans  &trans  &mo 4     &trans     &trans    &trans
            >;
        };

        arrow_layer2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp PG_UP  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PG_DN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
                        &trans  &trans  &trans    &trans  &trans    &trans
            >;
        };
    };
};
