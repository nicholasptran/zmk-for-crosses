#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp MINUS       &kp N1   &kp N2  &kp N3        &kp N4       &kp N5    &kp N6  &kp N7     &kp N8         &kp N9   &kp N0    &kp EQUAL
&kp TAB         &kp Q    &kp W   &kp E         &kp R        &kp T     &kp Y   &kp U      &kp I          &kp O    &kp P     &kp BSLH
&kp LEFT_SHIFT  &kp A    &kp S   &kp D         &kp F        &kp G     &kp H   &kp J      &kp K          &kp L    &kp SEMI  &kp APOS
&kp LCTRL       &lt 3 Z  &kp X   &kp C         &kp V        &kp B     &kp N   &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                                 &kp LEFT_ALT  &lt 1 SPACE  &mo 2     &mo 3   &kp ENTER  &kp RIGHT_ALT
            >;

            label = "QWRT";
        };

        mouse_layer {
            bindings = <
&kp LS(N1)      &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)    &kp LS(N7)  &kp LS(N8)      &kp LS(N9)      &kp LS(N0)       &kp LS(MINUS)  &kp LS(EQUAL)
&kp TAB         &kp Q       &kp W       &kp E       &kp R       &kp T         &kp Y       &kp U           &kp I           &kp O            &kp P          &kp BSLH
&kp LEFT_SHIFT  &kp A       &kp S       &kp D       &kp F       &kp G         &kp H       &kp J           &kp UP_ARROW    &kp L            &kp SEMI       &kp APOS
&kp LCTRL       &kp Z       &kp X       &kp C       &kp V       &kp B         &kp N       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SLASH      &kp ESC
                                        &none       &none       &none         &kp F11     &kp F12         &kp SPACE
            >;

            label = "MOUSE";
        };

        scroll_layer {
            bindings = <
&trans          &kp F1  &kp F2  &kp F3  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11    &kp F12
&trans          &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp N7  &kp N8  &kp N9   &kp EQUAL  &kp BSLH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp N4  &kp N5  &kp N6   &kp SEMI   &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C   &kp V   &kp B     &kp N   &kp N1  &kp N2  &kp N3   &kp SLASH  &kp ESC
                                &trans  &trans  &trans    &trans  &trans  &kp N0
            >;

            label = "SCROLL";
        };

        arrow_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans    &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PSCRN  &trans    &kp UP    &kp EQUAL  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans    &trans    &trans     &trans     &trans
                        &trans  &trans  &mo 4     &trans     &trans    &trans
            >;
        };

        arrow_layer2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp PG_UP  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PG_DN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
                        &trans  &trans  &trans    &trans  &trans    &trans
            >;
        };
    };
};
